# Secrets - never commit .env contents
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
.pytest_cache/
*.pyc

# Node / frontend build output
node_modules/
dist/

# gltest scratch output (repo root only)
/artifacts/

# Large or scratch media artifacts
*.webm
*.wav

# Evidence scratch checkpoint and run log (regenerated each run)
evidence/_checkpoint.json
evidence/_run.log
evidence/_verify2.log
evidence/_lint1.txt
evidence/_lint2.txt
evidence/_ci.log

# Generated media scratch (video frames, wav beds); final mp4 and png are tracked
build/

# Publish helpers (contain nothing, created and removed per run)
.git-askpass.cmd
.gh-pages-work/

# OS / editor noise
.DS_Store
Thumbs.db

